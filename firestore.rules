rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function verifiedOrAnonymous(uid) {
      return signedInAs(uid) &&
        (request.auth.token.firebase.sign_in_provider == 'anonymous' ||
         request.auth.token.email_verified == true);
    }

    // الإحصاءات السحابية مقتصرة على صاحب حساب دائم موثّق بالبريد.
    // يظل الضيف مستخدمًا للتخزين المحلي فقط كما ينفذ التطبيق.
    function verifiedAccountOwner(uid) {
      return signedInAs(uid) &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.auth.token.email_verified == true;
    }

    function validReadingStatsPreferences(data) {
      return data is map &&
        data.keys().hasOnly([
          'syncEnabled',
          'dailyGoalMinutes',
          'weeklyGoalMinutes',
          'weeklyGoalChapters',
          'minimumActiveDayMinutes',
          'weeklySummaryEnabled',
          'schemaVersion',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'syncEnabled',
          'dailyGoalMinutes',
          'weeklyGoalMinutes',
          'weeklySummaryEnabled',
          'schemaVersion',
          'updatedAt'
        ]) &&
        data.syncEnabled is bool &&
        data.dailyGoalMinutes is int &&
        data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 720 &&
        data.weeklyGoalMinutes is int &&
        data.weeklyGoalMinutes >= 30 && data.weeklyGoalMinutes <= 10080 &&
        (!data.keys().hasAny(['weeklyGoalChapters']) ||
          (data.weeklyGoalChapters is int &&
           data.weeklyGoalChapters >= 0 && data.weeklyGoalChapters <= 1000)) &&
        (!data.keys().hasAny(['minimumActiveDayMinutes']) ||
          (data.minimumActiveDayMinutes is int &&
           data.minimumActiveDayMinutes >= 1 && data.minimumActiveDayMinutes <= 120)) &&
        data.weeklySummaryEnabled is bool &&
        data.schemaVersion is int && data.schemaVersion == 1 &&
        data.updatedAt is timestamp;
    }

    function validReadingSession(data, sessionId) {
      return data is map &&
        data.keys().hasOnly([
          'sessionId',
          'comicId',
          'sourceId',
          'title',
          'coverImage',
          'type',
          'chapterId',
          'chapterTitle',
          'startedAt',
          'endedAt',
          'durationSeconds',
          'dailySeconds',
          'progress',
          'chapterCompleted',
          'chapterCompletedDay',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'sessionId',
          'comicId',
          'sourceId',
          'title',
          'type',
          'chapterId',
          'chapterTitle',
          'startedAt',
          'endedAt',
          'durationSeconds',
          'dailySeconds',
          'progress',
          'chapterCompleted',
          'chapterCompletedDay',
          'updatedAt'
        ]) &&
        data.sessionId is string && data.sessionId == sessionId &&
        sessionId.size() > 0 && sessionId.size() <= 128 &&
        data.comicId is string && data.comicId.size() > 0 && data.comicId.size() <= 2048 &&
        data.sourceId is string && data.sourceId.size() > 0 && data.sourceId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        (!data.keys().hasAny(['coverImage']) ||
          (data.coverImage is string && data.coverImage.size() <= 2048 &&
           (data.coverImage == '' || data.coverImage.matches('^https?://.+')))) &&
        data.type is string &&
        data.type in ['manga', 'manhwa', 'manhua', 'novel', 'other'] &&
        data.chapterId is string && data.chapterId.size() <= 2048 &&
        data.chapterTitle is string && data.chapterTitle.size() <= 250 &&
        data.startedAt is timestamp && data.endedAt is timestamp &&
        data.durationSeconds is int &&
        data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
        data.dailySeconds is map && data.dailySeconds.keys().size() <= 31 &&
        data.progress is number && data.progress >= 0 && data.progress <= 1 &&
        data.chapterCompleted is bool &&
        (data.chapterCompletedDay == null ||
          (data.chapterCompletedDay is string &&
           data.chapterCompletedDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        data.updatedAt is timestamp;
    }

    match /userProfiles/{uid} {
      // بيانات الحساب لا يقرأها إلا صاحب الحساب.
      allow get: if signedInAs(uid);
      allow list: if false;

      // إنشاء الملف مسموح لصاحبه فقط، ولا يستطيع العميل منح نفسه توثيقًا.
      allow create: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.isVerified == false
        && request.resource.data.isOfficialDeveloper == false;

      // الهوية والبريد والدولة والجنس وحالة التوثيق ووقت الإنشاء حقول ثابتة.
      // يسمح للمستخدم بتغيير الاسم الظاهر والنبذة والصورة والمزامنة وإعدادات العرض فقط.
      allow update: if verifiedOrAnonymous(uid)
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.get('username', null) == resource.data.get('username', null)
        && request.resource.data.get('gender', null) == resource.data.get('gender', null)
        && request.resource.data.get('countryCode', null) == resource.data.get('countryCode', null)
        && request.resource.data.get('countryName', null) == resource.data.get('countryName', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('birthDate', null) == resource.data.get('birthDate', null)
        && request.resource.data.get('isGuest', null) == resource.data.get('isGuest', null)
        && request.resource.data.get('emailVerified', null) == resource.data.get('emailVerified', null)
        && request.resource.data.get('isVerified', null) == resource.data.get('isVerified', null)
        && request.resource.data.get('isOfficialDeveloper', null) == resource.data.get('isOfficialDeveloper', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'photoUrl', 'photoData', 'syncFavorites', 'settings'
        ])
        && (!request.resource.data.keys().hasAll(['displayName'])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 40))
        && (!request.resource.data.keys().hasAll(['photoUrl'])
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048))
        && (!request.resource.data.keys().hasAll(['photoData'])
          || (request.resource.data.photoData is string
            && request.resource.data.photoData.size() <= 850000))
        && (!request.resource.data.keys().hasAll(['bio'])
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 300))
        && (!request.resource.data.keys().hasAll(['syncFavorites'])
          || request.resource.data.syncFavorites is bool)
        && (!request.resource.data.keys().hasAll(['settings'])
          || (request.resource.data.settings is map
            && request.resource.data.settings.keys().hasOnly(['language', 'themeMode'])
            && request.resource.data.settings.language in ['ar_SA', 'en_US']
            && request.resource.data.settings.themeMode in ['dark', 'light']));

      // حذف الحساب من التطبيق غير متاح من خلال العميل.
      allow delete: if false;

      match /private/library {
        allow read, write: if verifiedOrAnonymous(uid);
      }

      match /private/favorites/{mangaKey} {
        allow read, write: if verifiedOrAnonymous(uid);
      }

      match /private/readingProgress/{mangaKey} {
        allow read, write: if verifiedOrAnonymous(uid);
      }

      match /private/readingHistory/{entryId} {
        allow read, write: if verifiedOrAnonymous(uid);
      }

      match /private/customLists/{listId} {
        allow read, write: if verifiedOrAnonymous(uid);
      }

      match /private/notifications/{notificationId} {
        allow read, create, update, delete: if verifiedOrAnonymous(uid);
      }

      // إعدادات مزامنة الإحصاءات الخاصة بصاحب الحساب فقط.
      match /private/readingStats {
        allow get: if verifiedAccountOwner(uid);
        allow list: if false;
        allow create, update: if verifiedAccountOwner(uid)
          && validReadingStatsPreferences(request.resource.data);
        allow delete: if false;

        // كل جلسة مستقلة؛ يمكن حذفها عند تأكيد إعادة ضبط الإحصاءات.
        match /sessions/{sessionId} {
          allow get, list: if verifiedAccountOwner(uid);
          allow create, update: if verifiedAccountOwner(uid)
            && validReadingSession(request.resource.data, sessionId);
          allow delete: if verifiedAccountOwner(uid);
        }
      }
    }

    match /usernames/{username} {
      // فحص توفر الاسم مسموح، وقراءة المجموعة كاملة ممنوعة.
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(
          /databases/$(database)/documents/usernames/$(username)
        );

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'createdAt'
        ]);

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // إعلانات محور التطبيق للعرض داخل صندوق الإشعارات. الكتابة محصورة بخادم الإدارة.
    match /appNotifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    // إغلاق كل مسار غير مصرح به أعلاه.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
